# Replace tags with immutable digests after your canary has passed.
SIDECAR_IMAGE=ghcr.io/simplez2/cpa-codex-agent-identity:v0.3.6
CPA_IMAGE=eceasy/cli-proxy-api:v7.2.145
SIDECAR_ROOT=./runtime
SIDECAR_UID=65532
SIDECAR_GID=65532
AGENT_IDENTITY_NETWORK=agent-identity
# Keep rw for Plugin Store install/update; switch to ro for steady-state operation.
CPA_PLUGIN_MOUNT_MODE=rw
# The plugin uses these values for its internal quota/reset-credit bridge when sidecar_api_url is blank.
CODEX_AGENT_IDENTITY_SIDECAR_HOSTS=codex-agent-identity-sidecar
# Optional explicit internal URL; if blank, the first host uses port 8787 unless an indexed port is supplied below.
CODEX_AGENT_IDENTITY_SIDECAR_API_URL=
# Optional additional HTTP ports accepted by the plugin parser; 8787 is always allowed, and loopback also allows 18787.
CODEX_AGENT_IDENTITY_SIDECAR_HTTP_PORTS=
PUBLIC_CPA_BASE_URL=http://codex-agent-identity-sidecar:8787/backend-api/codex
EMBED_ALLOWED_ORIGINS=http://127.0.0.1:8317
CANARY_EMBED_ALLOWED_ORIGINS=http://127.0.0.1:18317
TZ=UTC
