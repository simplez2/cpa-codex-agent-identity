index 0000000000000000000000000000000000000000..c3c9f3887a8217540ea2998d0eaec8cfacab9dd4
--- /dev/null
+++ b/src/features/plugins/agentIdentityManagement.ts
@@ -0,0 +1,19 @@
+export const AGENT_IDENTITY_PLUGIN_ID = 'codex-agent-identity';
+
+const AGENT_IDENTITY_MANAGEMENT_PATH = '/agent-identity/';
+
+export const buildAgentIdentityManagementURL = (apiBase: string): string | null => {
+  try {
+    const base = new URL(apiBase);
+    if (
+      (base.protocol !== 'http:' && base.protocol !== 'https:') ||
+      base.username ||
+      base.password
+    ) {
+      return null;
+    }
+    return new URL(AGENT_IDENTITY_MANAGEMENT_PATH, base.origin).toString();
+  } catch {
+    return null;
+  }
+};
diff --git a/tests/agentIdentityManagement.test.ts b/tests/agentIdentityManagement.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..463347a12e901276709c165faed3b992b49dc80d
--- /dev/null
+++ b/tests/agentIdentityManagement.test.ts
@@ -0,0 +1,36 @@
+import { describe, expect, test } from 'bun:test';
+import {
+  AGENT_IDENTITY_PLUGIN_ID,
+  buildAgentIdentityManagementURL,
+} from '../src/features/plugins/agentIdentityManagement';
+
+describe('Agent Identity management entry', () => {
+  test('targets the configured CPA origin and preserves its port', () => {
+    expect(buildAgentIdentityManagementURL('https://cpa.example.test:9443')).toBe(
+      'https://cpa.example.test:9443/agent-identity/'
+    );
+  });
+
+  test('deliberately targets the origin-root sidecar route', () => {
+    expect(buildAgentIdentityManagementURL('https://cpa.example.test/proxy/cpa')).toBe(
+      'https://cpa.example.test/agent-identity/'
+    );
+  });
+
+  test('fails closed for missing, malformed, credentialed, and non-http bases', () => {
+    for (const value of [
+      '',
+      'not a URL',
+      'javascript:alert(1)',
+      'file:///tmp/cpa',
+      'https://user:password@cpa.example.test',
+    ]) {
+      expect(buildAgentIdentityManagementURL(value)).toBeNull();
+    }
+  });
+
+  test('matches only the canonical plugin identifier', () => {
+    expect(AGENT_IDENTITY_PLUGIN_ID).toBe('codex-agent-identity');
+    expect(AGENT_IDENTITY_PLUGIN_ID).not.toBe('codex-agent-identity-preview');
+  });
+});
